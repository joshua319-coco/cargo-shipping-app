{
  "manifest_version": 3,
  "name": "상화 대신 전산 연동",
  "version": "0.6.0",
  "description": "대신 미등록 출고건 등록(출력안함)과 발송데이터 조회를 연결합니다.",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://cargo-shipping-app.vercel.app/*",
    "https://partner.ds3211.co.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "https://cargo-shipping-app.vercel.app/*"
      ],
      "js": [
        "app-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "대신 전산 연동"
  }
}
